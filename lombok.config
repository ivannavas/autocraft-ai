# Marks this directory as the Lombok config root (stop searching parent folders).
config.stopBubbling = true

# Project-wide logging convention: @Slf4j generates a `log` field backed by
# org.slf4j.Logger (provided at compile time by Minecraft/Fabric).
lombok.log.fieldName = log
lombok.log.fieldIsStatic = true

# Annotate generated members so coverage / static-analysis tools skip them.
lombok.addLombokGeneratedAnnotation = true
